{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/mapa/(.*)",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/mapa",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/apresentacao/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/apresentacao",
      "destination": "/index.html"
    }
  ]
}
