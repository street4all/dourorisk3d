{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/mapa/(.*)",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/mapa",
      "destination": "/mapa/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/apresentacao",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/apresentacao/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
